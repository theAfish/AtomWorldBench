[structure_builder] tool_call: sandbox_run_command args={"command": "python3 -c \"\nimport numpy as np\nfrom ase.io import read, write\nfrom ase.geometry import find_mic\n\n# Read the structure\natoms = read('structure.cif')\n\n# Get the center atom position (index 8, assuming 0-based indexing)\ncenter_index = 8\nif center_index >= len(atoms):\n    raise ValueError(f'Center index {center_index} is out of range for structure with {len(atoms)} atoms')\ncenter_pos = atoms[center_index].position\n\n# Find all atoms within 3.9030 angstrom of the center atom\ncutoff = 3.9030\nsurrounding_indices = []\npositions = atoms.get_positions()\ncell = atoms.get_cell()\npbc = atoms.get_pbc()\n\nfor i, pos in enumerate(positions):\n    if i == center_index:\n        continue  # Skip the center atom itself\n    \n    if np.any(pbc):  # Handle periodic boundary conditions\n        vec, dist = find_mic(pos - center_pos, cell, pbc)\n    else:\n        vec = pos - center_pos\n        dist = np.linalg.norm(vec)\n    \n    if dist <= cutoff:\n        surrounding_indices.append(i)\n\nprint(f'Found {len(surrounding_indices)} atoms within {cutoff} Å of atom {center_index}')\n\n# Rotation parameters\nangle_deg = 175.3503\naxis = np.array([0.0, 1.0, 0.0])  # y-axis\nangle_rad = np.radians(angle_deg)\n\n# Normalize the rotation axis\naxis = axis / np.linalg.norm(axis)\n\n# Create rotation matrix using Rodrigues' rotation formula\ncos_theta = np.cos(angle_rad)\nsin_theta = np.sin(angle_rad)\none_minus_cos = 1.0 - cos_theta\n\n# Rotation matrix components\nR = np.array([\n    [cos_theta + axis[0]**2 * one_minus_cos, \n     axis[0] * axis[1] * one_minus_cos - axis[2] * sin_theta,\n     axis[0] * axis[2] * one_minus_cos + axis[1] * sin_theta],\n    [axis[1] * axis[0] * one_minus_cos + axis[2] * sin_theta,\n     cos_theta + axis[1]**2 * one_minus_cos,\n     axis[1] * axis[2] * one_minus_cos - axis[0] * sin_theta],\n    [axis[2] * axis[0] * one_minus_cos - axis[1] * sin_theta,\n     axis[2] * axis[1] * one_minus_cos + axis[0] * sin_theta,\n     cos_theta + axis[2]**2 * one_minus_cos]\n])\n\n# Apply rotation to surrounding atoms\nfor idx in surrounding_indices:\n    # Get vector from center to atom\n    original_vec = positions[idx] - center_pos\n    # Rotate the vector\n    rotated_vec = R @ original_vec\n    # Update the atom position\n    atoms[idx].position = center_pos + rotated_vec\n\n# Write the result\nwrite('result.cif', atoms, format='cif')\n\nprint(f'Successfully rotated {len(surrounding_indices)} atoms around atom {center_index}')\nprint(f'Result saved to result.cif')\n\""}
