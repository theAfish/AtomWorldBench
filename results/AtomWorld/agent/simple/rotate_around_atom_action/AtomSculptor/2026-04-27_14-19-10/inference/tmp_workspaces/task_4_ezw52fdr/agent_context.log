[structure_builder] tool_call: sandbox_run_command args={"command": "python3 -c \"\nimport numpy as np\nfrom ase.io import read, write\n\n# Read the input structure\natoms = read('structure.cif')\n\n# Get the center atom position (index 22, 0-based indexing so it's actually index 21)\ncenter_index = 21  # since ASE uses 0-based indexing\ncenter_pos = atoms[center_index].position\n\n# Calculate distances from center atom to all other atoms\nall_positions = atoms.get_positions()\ndistances = np.sqrt(np.sum((all_positions - center_pos)**2, axis=1))\n\n# Find atoms within 2.6255 Å (excluding the center atom itself)\ncutoff = 2.6255\nsurrounding_indices = np.where((distances <= cutoff) & (distances > 1e-8))[0]\n\nprint(f'Center atom index: {center_index} (original index 22)')\nprint(f'Number of surrounding atoms within {cutoff} Å: {len(surrounding_indices)}')\nprint(f'Surrounding atom indices: {surrounding_indices}')\n\n# Define rotation parameters\nangle_deg = 96.5988\naxis = np.array([1.0, 0.0, 0.0])  # x-axis\n\n# Create a copy of positions to modify\nnew_positions = all_positions.copy()\n\n# Rotate each surrounding atom around the center using right-hand rule\nangle_rad = np.radians(angle_deg)\ncos_a = np.cos(angle_rad)\nsin_a = np.sin(angle_rad)\n\n# Rotation matrix around x-axis (right-hand rule)\nrot_matrix = np.array([\n    [1, 0, 0],\n    [0, cos_a, -sin_a],\n    [0, sin_a, cos_a]\n])\n\n# Apply rotation to each surrounding atom\nfor idx in surrounding_indices:\n    # Translate atom to origin relative to center\n    rel_pos = all_positions[idx] - center_pos\n    # Rotate around x-axis\n    rotated_rel_pos = rot_matrix @ rel_pos\n    # Translate back to original center position\n    new_positions[idx] = center_pos + rotated_rel_pos\n\n# Update atom positions\natoms.set_positions(new_positions)\n\n# Write the result\nwrite('result.cif', atoms, format='cif')\n\nprint('Rotation completed and saved to result.cif')\n\""}
