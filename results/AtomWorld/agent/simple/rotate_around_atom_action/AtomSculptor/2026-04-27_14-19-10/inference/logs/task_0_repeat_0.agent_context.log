[structure_builder] tool_call: sandbox_run_command args={"command": "python3 -c \"\nimport numpy as np\nfrom ase.io import read, write\nfrom ase.geometry import rotate\n\n# Read the structure\natoms = read('structure.cif')\n\n# Get the center atom position (index 2)\ncenter_pos = atoms[2].position\n\n# Find atoms within 2.5475 angstrom of the center atom (excluding the center itself)\nsurrounding_indices = []\nfor i, atom in enumerate(atoms):\n    if i == 2:  # Skip the center atom itself\n        continue\n    distance = np.linalg.norm(atom.position - center_pos)\n    if distance <= 2.5475:\n        surrounding_indices.append(i)\n\nprint(f'Found {len(surrounding_indices)} atoms within 2.5475 Å of atom at index 2')\n\n# Create a copy of the atoms object for modification\nrotated_atoms = atoms.copy()\n\n# Rotate the surrounding atoms around the [0, 0, 1] axis by 94.3835 degrees\n# We need to translate to origin, rotate, then translate back\nrotation_axis = [0, 0, 1]\nrotation_angle = 94.3835  # degrees\n\nfor idx in surrounding_indices:\n    # Get the current position\n    pos = rotated_atoms[idx].position\n    \n    # Translate so center is at origin\n    translated_pos = pos - center_pos\n    \n    # Apply rotation around z-axis (which is [0,0,1])\n    # For rotation around z-axis, we can use simple 2D rotation in xy plane\n    cos_theta = np.cos(np.radians(rotation_angle))\n    sin_theta = np.sin(np.radians(rotation_angle))\n    \n    x_rot = translated_pos[0] * cos_theta - translated_pos[1] * sin_theta\n    y_rot = translated_pos[0] * sin_theta + translated_pos[1] * cos_theta\n    z_rot = translated_pos[2]  # z-coordinate unchanged for z-axis rotation\n    \n    rotated_translated_pos = np.array([x_rot, y_rot, z_rot])\n    \n    # Translate back\n    final_pos = rotated_translated_pos + center_pos\n    \n    # Update the atom position\n    rotated_atoms[idx].position = final_pos\n\n# Write the result\nwrite('result.cif', rotated_atoms, format='cif')\n\nprint('Rotation completed and saved to result.cif')\n\""}
