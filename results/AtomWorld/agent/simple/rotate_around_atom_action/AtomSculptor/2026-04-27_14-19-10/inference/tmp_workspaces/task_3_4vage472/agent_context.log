[structure_builder] tool_call: sandbox_run_command args={"command": "python3 -c \"\nimport numpy as np\nfrom ase.io import read, write\nfrom ase.geometry import get_distances\n\n# Read the input structure\natoms = read('structure.cif')\n\n# Get the center atom at index 14 (0-based indexing)\ncenter_index = 14\ncenter_pos = atoms.get_positions()[center_index]\n\n# Calculate distances from center atom to all other atoms\npositions = atoms.get_positions()\ndistances = np.linalg.norm(positions - center_pos, axis=1)\n\n# Find atoms within 2.9531 angstrom (excluding the center atom itself)\nradius = 2.9531\nsurrounding_indices = np.where((distances <= radius) & (distances > 1e-6))[0]\n\nprint(f'Center atom index: {center_index}')\nprint(f'Number of surrounding atoms within {radius} Å: {len(surrounding_indices)}')\nprint(f'Surrounding atom indices: {surrounding_indices}')\n\n# Define rotation parameters\nangle_deg = 234.4947\naxis = np.array([-1.0, 0.0, 0.0])  # Normalize the axis\naxis = axis / np.linalg.norm(axis)\n\n# Convert angle to radians\nangle_rad = np.radians(angle_deg)\n\n# Create rotation matrix using Rodrigues' rotation formula\ndef rotation_matrix(axis, theta):\n    '''\n    Return the rotation matrix associated with counterclockwise rotation about\n    the given axis by theta radians using Rodrigues' formula.\n    '''\n    axis = np.asarray(axis)\n    axis = axis / np.sqrt(np.dot(axis, axis))\n    a = np.cos(theta / 2.0)\n    b, c, d = -axis * np.sin(theta / 2.0)\n    aa, bb, cc, dd = a * a, b * b, c * c, d * d\n    bc, ad, ac, ab, bd, cd = b * c, a * d, a * c, a * b, b * d, c * d\n    return np.array([[aa + bb - cc - dd, 2 * (bc + ad), 2 * (bd - ac)],\n                     [2 * (bc - ad), aa + cc - bb - dd, 2 * (cd + ab)],\n                     [2 * (bd + ac), 2 * (cd - ab), aa + dd - bb - cc]])\n\n# Get rotation matrix\nrot_matrix = rotation_matrix(axis, angle_rad)\n\n# Apply rotation to surrounding atoms\noriginal_positions = atoms.get_positions()\nnew_positions = original_positions.copy()\n\nfor idx in surrounding_indices:\n    # Translate atom position relative to center\n    relative_pos = original_positions[idx] - center_pos\n    # Apply rotation\n    rotated_pos = rot_matrix @ relative_pos\n    # Translate back\n    new_positions[idx] = rotated_pos + center_pos\n\n# Update atom positions\natoms.set_positions(new_positions)\n\n# Write the result\nwrite('result.cif', atoms, format='cif')\n\nprint('Rotation completed and saved to result.cif')\n\""}
